+class AppealMedia(Base, AuditMixin):
+    """Bitta murojaatga biriktirilgan HAR BIR media fayl (rasm/video/ovoz/hujjat).
+
+    Appeal.media_type / Appeal.media_file_id ustunlari faqat BIRINCHI
+    (asosiy) faylni "eslatma" sifatida saqlaydi — orqaga moslik uchun.
+    Guruhga TO'LIQ ro'yxatni qayta yuborish yoki ko'rsatish kerak bo'lsa,
+    shu jadvaldan foydalaniladi (fuqaro bir vaqtda bir nechta rasm/video/
+    fayl biriktirishi mumkin).
+    """
+
+    __tablename__ = "appeal_media"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True)
+    appeal_id: Mapped[int] = mapped_column(ForeignKey("appeals.id"), nullable=False, index=True)
+    media_type: Mapped[str] = mapped_column(String(20), nullable=False)
+    media_file_id: Mapped[str] = mapped_column(String(255), nullable=False)
+    position: Mapped[int] = mapped_column(Integer, default=0, nullable=False)
+
+    appeal: Mapped["Appeal"] = relationship(back_populates="media_items")
+
+    def __repr__(self) -> str:
+        return f"<AppealMedia appeal_id={self.appeal_id} type={self.media_type}>"
+
+
 class AppealStatusHistory(Base, AuditMixin):
     """Audit trail: every status change of an appeal, who changed it and when."""
 
